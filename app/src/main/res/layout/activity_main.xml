<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:orientation="vertical">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_header_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/main_title_start"
            android:text="@string/title_main"
            android:textColor="@color/yp_white"
            android:textSize="@dimen/main_title_size"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/main_horizontal_padding"
        android:layout_marginTop="@dimen/main_first_card_margin_top"
        android:layout_marginEnd="@dimen/main_horizontal_padding"
        android:layout_marginBottom="@dimen/main_horizontal_padding"
        android:orientation="vertical">

        <Button
            android:id="@+id/button_search"
            style="@style/MainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/search_button"
            app:icon="@drawable/ic_search_24" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_card_spacing" />

        <Button
            android:id="@+id/button_media"
            style="@style/MainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/media_button"
            app:icon="@drawable/ic_media_24" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_card_spacing" />

        <Button
            android:id="@+id/button_settings"
            style="@style/MainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/settings_button"
            app:icon="@drawable/ic_settings_24" />

    </LinearLayout>

</LinearLayout>