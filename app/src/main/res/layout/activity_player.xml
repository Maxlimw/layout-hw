<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/player_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/player_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp" />
        <ImageButton
            android:id="@+id/player_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back_arrow_24"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@+id/player_cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            android:contentDescription="@string/player_cover_description"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_player_placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="@id/player_start"
            app:layout_constraintEnd_toStartOf="@id/player_end"
            app:layout_constraintTop_toBottomOf="@id/player_back" />
        <TextView
            android:id="@+id/player_track_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="@id/player_start"
            app:layout_constraintEnd_toStartOf="@id/player_end"
            app:layout_constraintTop_toBottomOf="@id/player_cover" />
        <TextView
            android:id="@+id/player_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/player_start"
            app:layout_constraintEnd_toStartOf="@id/player_end"
            app:layout_constraintTop_toBottomOf="@id/player_track_name" />
        <ImageButton
            android:id="@+id/player_play"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/player_play_background"
            android:contentDescription="@string/player_play"
            android:src="@drawable/ic_player_play"
            app:tint="@color/screen_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_artist" />
        <ImageButton
            android:id="@+id/player_playlist"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@drawable/player_secondary_background"
            android:contentDescription="@string/player_playlist"
            android:src="@drawable/ic_player_add"
            app:tint="@color/yp_white"
            app:layout_constraintStart_toStartOf="@id/player_start"
            app:layout_constraintTop_toTopOf="@id/player_play"
            app:layout_constraintBottom_toBottomOf="@id/player_play" />
        <ImageButton
            android:id="@+id/player_favorite"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:background="@drawable/player_secondary_background"
            android:contentDescription="@string/player_favorite"
            android:src="@drawable/ic_player_favorite"
            app:tint="@color/yp_white"
            app:layout_constraintEnd_toStartOf="@id/player_end"
            app:layout_constraintTop_toTopOf="@id/player_play"
            app:layout_constraintBottom_toBottomOf="@id/player_play" />
        <TextView
            android:id="@+id/player_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/player_initial_time"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_play" />
        <TextView
            android:id="@+id/player_duration_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/player_duration"
            android:textColor="@color/yp_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_duration"
            app:layout_constraintTop_toTopOf="@id/player_duration"
            app:layout_constraintBottom_toBottomOf="@id/player_duration" />
        <TextView
            android:id="@+id/player_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="39dp"
            android:minHeight="32dp"
            android:gravity="end|center_vertical"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_progress" />
        <TextView
            android:id="@+id/player_album_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/player_album"
            android:textColor="@color/yp_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_album"
            app:layout_constraintTop_toTopOf="@id/player_album"
            app:layout_constraintBottom_toBottomOf="@id/player_album" />
        <TextView
            android:id="@+id/player_album"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="0dp"
            android:minHeight="32dp"
            android:gravity="end|center_vertical"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_duration" />
        <TextView
            android:id="@+id/player_year_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/player_year"
            android:textColor="@color/yp_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_year"
            app:layout_constraintTop_toTopOf="@id/player_year"
            app:layout_constraintBottom_toBottomOf="@id/player_year" />
        <TextView
            android:id="@+id/player_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="0dp"
            android:minHeight="32dp"
            android:gravity="end|center_vertical"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_album" />
        <TextView
            android:id="@+id/player_genre_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/player_genre"
            android:textColor="@color/yp_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_genre"
            app:layout_constraintTop_toTopOf="@id/player_genre"
            app:layout_constraintBottom_toBottomOf="@id/player_genre" />
        <TextView
            android:id="@+id/player_genre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="0dp"
            android:minHeight="32dp"
            android:gravity="end|center_vertical"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_year" />
        <TextView
            android:id="@+id/player_country_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/player_country"
            android:textColor="@color/yp_gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_country"
            app:layout_constraintTop_toTopOf="@id/player_country"
            app:layout_constraintBottom_toBottomOf="@id/player_country" />
        <TextView
            android:id="@+id/player_country"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="0dp"
            android:minHeight="32dp"
            android:gravity="end|center_vertical"
            android:paddingVertical="6dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_genre"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/player_album_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="player_album,player_album_label" />
        <androidx.constraintlayout.widget.Group
            android:id="@+id/player_year_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="player_year,player_year_label" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
