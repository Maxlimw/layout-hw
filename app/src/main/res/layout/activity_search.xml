<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/search_header_padding_start">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/back_button_size"
            android:layout_height="@dimen/back_button_size"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back_arrow_24"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_title_start"
            android:fontFamily="sans-serif-bold"
            android:text="@string/search_button"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/search_title_size" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_field_height"
        android:layout_marginStart="@dimen/main_horizontal_padding"
        android:layout_marginTop="@dimen/search_field_margin_top"
        android:layout_marginEnd="@dimen/main_horizontal_padding"
        android:background="@drawable/search_edit_text_background">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/search_icon_margin_start"
            android:contentDescription="@null"
            android:src="@drawable/ic_search_24"
            app:tint="@color/icon_secondary" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/search_edit_text_margin_start"
            android:layout_marginEnd="@dimen/search_edit_text_margin_end"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:paddingVertical="@dimen/search_edit_text_padding_vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/icon_secondary"
            android:textCursorDrawable="@drawable/search_cursor"
            android:textSize="@dimen/search_text_size" />

        <ImageView
            android:id="@+id/clear_icon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/search_icon_margin_end"
            android:contentDescription="@string/clear_search"
            android:src="@drawable/ic_clear_24"
            android:visibility="gone"
            app:tint="@color/icon_secondary" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracks_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/tracks_list_margin_top"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/placeholder_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/placeholder_margin_top"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/placeholder_horizontal_padding"
            android:visibility="gone">

            <ImageView
                android:id="@+id/placeholder_image"
                android:layout_width="@dimen/placeholder_image_size"
                android:layout_height="@dimen/placeholder_image_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_nothing_found" />

            <TextView
                android:id="@+id/placeholder_message"
                android:layout_width="@dimen/placeholder_message_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/placeholder_message_margin_top"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/placeholder_text_line_spacing"
                android:text="@string/nothing_found"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/placeholder_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/placeholder_refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/placeholder_button_height"
                android:layout_marginTop="@dimen/placeholder_button_margin_top"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="@dimen/placeholder_button_padding_start"
                android:paddingEnd="@dimen/placeholder_button_padding_end"
                android:text="@string/refresh"
                android:textAllCaps="false"
                android:textColor="@color/screen_background"
                android:textSize="@dimen/placeholder_button_text_size"
                android:visibility="gone"
                app:backgroundTint="@color/text_primary"
                app:cornerRadius="@dimen/placeholder_button_corner_radius" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
